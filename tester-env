#!/usr/bin/env bash
set -euo pipefail

# Cacti - Tester Environment CLI
# Usage: ./tester-env <command> [--run-id <id>] [--port <port>] [--source-dir <path>]
# Commands: deploy, seed, verify, reset, stop, logs, status

RUN_ID="default"
PORT="8089"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Build context is the submodule itself; the tester-env CLI is committed
# into the fork alongside the source it builds.
SOURCE_DIR="${SOURCE_DIR:-${SCRIPT_DIR}}"

# Cacti-specific settings
DB_ROOT_PASSWORD="root"
DB_NAME="cacti"
DB_USER="cacti"
DB_PASSWORD="cacti"
DB_PORT="3306"
PHP_MEMORY_LIMIT="512M"
TIMEZONE="UTC"

ADMIN_USER="admin"
ADMIN_PASS="admin123"

refresh_names() {
    COMPOSE_PROJECT="tester-env-cacti"
    if [[ "${RUN_ID}" != "default" ]]; then
        COMPOSE_PROJECT="${COMPOSE_PROJECT}-${RUN_ID}"
        # Upstream docker-compose.yml hardcodes container_name: cacti_web / cacti_db.
        # Parallel runs with --run-id need the compose file edited to use unique names,
        # or a separate source tree. For single-run deploys, use the fixed names.
        WEB_CONTAINER="cacti_web-${RUN_ID}"
        DB_CONTAINER="cacti_db-${RUN_ID}"
    else
        WEB_CONTAINER="cacti_web"
        DB_CONTAINER="cacti_db"
    fi
}

compose_env() {
    echo "WEB_PORT=${PORT}"
    echo "DB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}"
    echo "DB_NAME=${DB_NAME}"
    echo "DB_USER=${DB_USER}"
    echo "DB_PASSWORD=${DB_PASSWORD}"
    echo "DB_PORT=${DB_PORT}"
    echo "PHP_MEMORY_LIMIT=${PHP_MEMORY_LIMIT}"
    echo "TIMEZONE=${TIMEZONE}"
}

clone_source() {
    if [[ ! -d "${SOURCE_DIR}/.git" ]]; then
        echo "ERROR: SOURCE_DIR=${SOURCE_DIR} is not a git checkout. The CLI" >&2
        echo "expects to run from inside the Cacti fork submodule." >&2
        exit 1
    fi
    echo "==> Source at: ${SOURCE_DIR}"
    echo "==> Commit: $(git -C "${SOURCE_DIR}" rev-parse --short HEAD)"
}

post_deploy_fixups() {
    echo "==> Applying runtime fixups..."

    # Create php.ini to suppress PHP 8.4 deprecation warnings that break the CLI installer
    # (Deprecated: Constant E_STRICT and nullable parameter warnings pollute stdout,
    #  causing json_decode in utility_php_extensions to fail)
    docker exec "${WEB_CONTAINER}" bash -c 'cat > /usr/local/etc/php/php.ini <<EOF
memory_limit = 512M
date.timezone = UTC
max_execution_time = 60
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT
display_errors = Off
EOF
'

    # Install fping (required by Cacti for device availability checks)
    docker exec "${WEB_CONTAINER}" apt-get update -qq 2>/dev/null
    docker exec "${WEB_CONTAINER}" apt-get install -y -qq fping 2>/dev/null || true

    # Create cache subdirectories (not created by Dockerfile, needed for install)
    docker exec "${WEB_CONTAINER}" bash -c '
        mkdir -p /var/www/html/cacti/cache/{boost,mibcache,realtime,spikekill}
        chown -R www-data:www-data /var/www/html/cacti/cache/
    '
}

run_installer() {
    echo "==> Running Cacti CLI installer..."
    docker exec "${WEB_CONTAINER}" php /var/www/html/cacti/cli/install_cacti.php \
        --install --accept-eula 2>&1 | grep -v 'Deprecated' || {
        echo "ERROR: Cacti CLI installer failed."
        return 1
    }

    echo "==> Setting deterministic admin password (${ADMIN_USER} / ${ADMIN_PASS})..."
    # Set admin password and disable forced password change
    local passhash
    passhash=$(echo -n "${ADMIN_PASS}" | md5sum | awk '{print $1}')
    docker exec "${DB_CONTAINER}" mariadb -u"${DB_USER}" -p"${DB_PASSWORD}" "${DB_NAME}" -e \
        "UPDATE user_auth SET password = '${passhash}', must_change_password = '', password_change = 'on' WHERE username = '${ADMIN_USER}';" 2>/dev/null

    echo "==> Fixing file ownership (installer runs as root, web runs as www-data)..."
    docker exec "${WEB_CONTAINER}" chown -R www-data:www-data \
        /var/www/html/cacti/log/ \
        /var/www/html/cacti/cache/ \
        /var/www/html/cacti/rra/
}

cmd_deploy() {
    echo "==> Deploying Cacti (run-id: ${RUN_ID}, port: ${PORT})"
    echo "    Project: ${COMPOSE_PROJECT}"
    echo "    Source:  ${SOURCE_DIR}"

    clone_source

    # Copy .env.example to .env if needed
    if [[ ! -f "${SOURCE_DIR}/.env" ]]; then
        cp "${SOURCE_DIR}/.env.example" "${SOURCE_DIR}/.env"
    fi

    echo "==> Building and starting containers..."
    env $(compose_env) \
        docker compose -f "${SOURCE_DIR}/docker-compose.yml" -p "${COMPOSE_PROJECT}" \
        up -d --build 2>&1 | tail -5

    echo "==> Waiting for database to be healthy..."
    local max_attempts=60
    local attempt=1
    while [ $attempt -le $max_attempts ]; do
        local db_status
        db_status=$(docker inspect "${DB_CONTAINER}" --format '{{.State.Health.Status}}' 2>/dev/null || echo "starting")
        if [[ "$db_status" == "healthy" ]]; then
            echo "==> Database is healthy."
            break
        fi
        sleep 2
        attempt=$((attempt + 1))
    done

    echo "==> Waiting for web container to be healthy..."
    attempt=1
    while [ $attempt -le $max_attempts ]; do
        local web_status
        web_status=$(docker inspect "${WEB_CONTAINER}" --format '{{.State.Health.Status}}' 2>/dev/null || echo "starting")
        if [[ "$web_status" == "healthy" ]]; then
            echo "==> Web container is healthy."
            break
        fi
        sleep 2
        attempt=$((attempt + 1))
    done

    post_deploy_fixups
    run_installer

    echo "==> Deployment complete."
    echo "    URL:           http://localhost:${PORT}/cacti/"
    echo "    Browser MCP:   http://host.docker.internal:${PORT}/cacti/"
    echo "    User:          ${ADMIN_USER}"
    echo "    Password:      ${ADMIN_PASS}"
}

