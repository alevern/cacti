cmd_verify() {
    echo "==> Verifying Cacti deployment..."

    # Check web server responds
    if ! curl -sf -o /dev/null "http://localhost:${PORT}/cacti/"; then
        echo "==> Verification FAILED: Web server not responding at http://localhost:${PORT}/cacti/"
        return 1
    fi
    echo "==> Web server responds at /cacti/"

    # Check login page shows Cacti
    if ! curl -sf "http://localhost:${PORT}/cacti/index.php" | grep -q 'Cacti'; then
        echo "==> Verification FAILED: Cacti login page not detected."
        return 1
    fi
    echo "==> Login page detected."

    # Check database has admin user
    local admin_count
    admin_count=$(docker exec "${DB_CONTAINER}" mariadb -u"${DB_USER}" -p"${DB_PASSWORD}" "${DB_NAME}" -N -e \
        "SELECT COUNT(*) FROM user_auth WHERE username = '${ADMIN_USER}';" 2>/dev/null)
    if [[ "${admin_count}" != "1" ]]; then
        echo "==> Verification FAILED: Admin user not found in database."
        return 1
    fi
    echo "==> Admin user present in database."

    local db_cmd=(docker exec -i "${DB_CONTAINER}" mariadb -N -u"${DB_USER}" -p"${DB_PASSWORD}" "${DB_NAME}")

    local seed_counts
    seed_counts=$("${db_cmd[@]}" -e "SELECT CONCAT((SELECT COUNT(*) FROM sites WHERE name IN ('Portland Edge DC','Denver Core DC','Remote Retail Labs')), ',', (SELECT COUNT(*) FROM host WHERE external_id LIKE 'NW-%'), ',', (SELECT COUNT(*) FROM graph_tree WHERE name='Northwind Network Operations'), ',', (SELECT COUNT(*) FROM graph_tree_items gti JOIN graph_tree gt ON gt.id=gti.graph_tree_id WHERE gt.name='Northwind Network Operations'));" 2>/dev/null)
    if [[ "${seed_counts}" != "3,6,1,9" ]]; then
        echo "==> Verification FAILED: Seed counts mismatch (sites,hosts,trees,tree_items=${seed_counts}; expected 3,6,1,9)."
        return 1
    fi
    echo "==> Seed counts verified: 3 sites, 6 devices, 1 tree, 9 tree items."

    local status_counts
    status_counts=$("${db_cmd[@]}" -e "SELECT CONCAT(SUM(status=3), ',', SUM(status=2), ',', SUM(status=1), ',', SUM(status=4), ',', SUM(disabled='on')) FROM host WHERE external_id LIKE 'NW-%';" 2>/dev/null)
    if [[ "${status_counts}" != "2,1,1,1,1" ]]; then
        echo "==> Verification FAILED: Seed status mix mismatch (up,recovering,down,error,disabled=${status_counts}; expected 2,1,1,1,1)."
        return 1
    fi
    echo "==> Seed status mix verified: 2 up, 1 recovering, 1 down, 1 error, 1 disabled."

    local expected_names
    expected_names="Denver Billing Database|Denver Core Switch Stack|Portland Checkout API Probe|Portland Edge Router|Retail Lab Long Haul Backup Link|Retail Lab Sensor Gateway"
    local actual_names
    actual_names=$("${db_cmd[@]}" -e "SELECT GROUP_CONCAT(description ORDER BY description SEPARATOR '|') FROM host WHERE external_id LIKE 'NW-%';" 2>/dev/null)
    if [[ "${actual_names}" != "${expected_names}" ]]; then
        echo "==> Verification FAILED: Seed device names mismatch."
        echo "    Actual:   ${actual_names}"
        echo "    Expected: ${expected_names}"
        return 1
    fi
    echo "==> Seed device names verified."

    echo "==> Verification passed."
}

cmd_reset() {
    echo "==> Resetting environment (project: ${COMPOSE_PROJECT})..."
    env $(compose_env) \
        docker compose -f "${SOURCE_DIR}/docker-compose.yml" -p "${COMPOSE_PROJECT}" \
        down -v 2>/dev/null || true
    echo "==> Reset complete. Run 'deploy' to start fresh."
}

cmd_stop() {
    echo "==> Stopping containers (project: ${COMPOSE_PROJECT})..."
    env $(compose_env) \
        docker compose -f "${SOURCE_DIR}/docker-compose.yml" -p "${COMPOSE_PROJECT}" \
        down 2>/dev/null || true
    echo "==> Stopped."
}

cmd_logs() {
    docker logs -f "${WEB_CONTAINER}" 2>/dev/null || echo "No containers running."
}

cmd_status() {
    echo "=== Cacti Status ==="
    echo "Run ID:     ${RUN_ID}"
    echo "Project:    ${COMPOSE_PROJECT}"
    echo "Port:       ${PORT}"
    echo "Source:     ${SOURCE_DIR}"
    echo ""

    local running
    running=$(docker ps --filter "name=${WEB_CONTAINER}" --filter "name=${DB_CONTAINER}" --format "{{.Names}}" 2>/dev/null || true)

    if [ -n "$running" ]; then
        echo "Status: RUNNING"
        echo "URL:    http://localhost:${PORT}/cacti/"
        echo "User:   ${ADMIN_USER}"
        echo ""
        docker ps --filter "name=${WEB_CONTAINER}" --filter "name=${DB_CONTAINER}" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null
    else
        echo "Status: NOT RUNNING"
    fi
}

cmd_help() {
    cat <<EOF
Cacti - Tester Environment CLI

Usage: ./tester-env <command> [--run-id <id>] [--port <port>] [--source-dir <path>]

Commands:
  deploy       Clone source (if needed), build Docker image, start containers,
               apply runtime fixups, run CLI installer, set admin credentials.
  seed         Populate deterministic Northwind network sites, devices, and tree.
  verify       Health-check web/login/admin plus deterministic seed counts.
  reset        Stop containers, remove containers and named volumes.
  stop         Stop containers (preserves data).
  logs         Tail all container logs.
  status       Show container status, URL, and credentials.
  help         Show this help message.

Options:
  --run-id <id>     Isolate containers and volumes for parallel runs.
                    Uses distinct docker compose project names.
                    Default: default
  --port <port>     Host port to bind. Container port is always 80.
                    Default: 8089
  --source-dir <p>  Path to Cacti source checkout.
                    Default: ${SOURCE_DIR}
  --help|-h         Show this help message.

Credentials:
  Admin:  ${ADMIN_USER} / ${ADMIN_PASS}
  DB:     ${DB_USER} / ${DB_PASSWORD} (database: ${DB_NAME})

Reset path:
  ./tester-env reset && ./tester-env deploy && ./tester-env seed && ./tester-env verify

Parallel runs:
  ./tester-env deploy --run-id run-001 --port 8091
  ./tester-env deploy --run-id run-002 --port 8092
  ./tester-env reset --run-id run-001

Caveats:
  - PHP 8.4 deprecation warnings break the CLI installer; suppressed via php.ini.
  - fping must be installed in the web container for path checks to pass.
  - Cache subdirectories (boost, mibcache, realtime, spikekill) must be created.
  - Schema auto-imports cacti.sql on first DB start (mounted as init script).
  - Built from editable source via bind mount at /var/www/html/cacti.
  - Browser MCP access via http://host.docker.internal:{port}/cacti/.
  - First login may redirect to /cacti/index.php after login POST with CSRF token.
EOF
}

main() {
    local cmd="${1:-help}"

    for ((i=2; i<=$#; i++)); do
        local arg="${!i}"
        case "${arg}" in
            --run-id)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    RUN_ID="${!next}"
                    ((i++))
                else
                    echo "Error: --run-id requires a value"
                    exit 1
                fi
                ;;
            --port)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    PORT="${!next}"
                    ((i++))
                else
                    echo "Error: --port requires a value"
                    exit 1
                fi
                ;;
            --source-dir)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    SOURCE_DIR="${!next}"
                    ((i++))
                else
                    echo "Error: --source-dir requires a value"
                    exit 1
                fi
                ;;
            --help|-h)
                cmd_help
                exit 0
                ;;
            *)
                echo "Unknown option: ${arg}"
                cmd_help
                exit 1
                ;;
        esac
    done

    refresh_names

    case "${cmd}" in
        deploy) cmd_deploy ;;
        seed) cmd_seed ;;
        verify) cmd_verify ;;
        reset) cmd_reset ;;
        stop) cmd_stop ;;
        logs) cmd_logs ;;
        status) cmd_status ;;
        help|--help|-h) cmd_help ;;
        *)
            echo "Unknown command: ${cmd}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
